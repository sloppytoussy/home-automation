# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_token_here
INFLUXDB_ORG=home
INFLUXDB_BUCKET=home_metrics

# MQTT Broker
MQTT_HOST=192.168.1.x
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Power Dashboard
POWER_METER_IP=192.168.1.x
POWER_METER_PORT=502

# Water Monitor
WATER_SENSOR_MQTT_TOPIC=home/water/tanks
TANK_CAPACITY_LITERS=5000

# Solar & Battery
INVERTER_IP=192.168.1.x
INVERTER_PORT=8899
BATTERY_CAPACITY_KWH=10

# DNS Monitor
DNS_SERVER_IP=192.168.1.x
DNS_LOG_PATH=/var/log/pihole/pihole.log

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=
