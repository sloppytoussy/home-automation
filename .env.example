# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_token_here
INFLUXDB_ORG=home
INFLUXDB_BUCKET=home_metrics

# MQTT Broker
MQTT_HOST=192.168.1.x
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Power Dashboard (Landis+Gyr JH145 — manual entry)
POWER_DASHBOARD_PORT=5001

# Water Monitor
# Tank config lives in projects/water-monitor/config/tanks.yaml
# Set MQTT topics and Tuya credentials there, not here.
WATER_DASHBOARD_PORT=5002

# Solar & Battery
# Inverter/collector config lives in projects/solar-battery/config/inverter.yaml
# Set collector.type (mqtt|modbus|solarman) and credentials there.
SOLAR_DASHBOARD_PORT=5003

# DNS Monitor (Pi-hole v6)
PIHOLE_HOST=192.168.1.x       # IP of your Raspberry Pi
PIHOLE_PORT=80                 # 80 for HTTP, 443 for HTTPS
PIHOLE_PASSWORD=               # Pi-hole admin password
PIHOLE_TLS=false               # set true if using HTTPS
DNS_POLL_INTERVAL=30           # seconds between polls
DASHBOARD_PORT=5000

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=
